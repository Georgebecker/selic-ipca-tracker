# =========================================================
#  selic-ipca-tracker - variaveis de ambiente
#  Passo 1: copie este arquivo para `.env`
#  Passo 2: preencha com os valores do SEU ambiente
#  NUNCA envie o `.env` para o repositorio (esta no .gitignore)
# =========================================================

# --- Projeto / caminhos ------------------------------------
PROJETO_NOME=selic-ipca-tracker
PASTA_RAIZ=.
PASTA_DADOS_RAW=data/raw
PASTA_DADOS_PROCESSED=data/processed
PASTA_DADOS_DESCARTADOS=data/descartados
PASTA_NOTEBOOKS=notebooks
PASTA_SAIDAS=saidas

# --- Banco de dados (SQL) -----------------------------------
# SQLite (padrao, sem servidor):
DB_URL=sqlite:///data/selic_ipca.db
# PostgreSQL (exemplo):
# DB_URL=postgresql://usuario:senha@localhost:5432/nome_do_banco
DB_ECHO=false

# --- Execucao / qualidade -----------------------------------
LOG_NIVEL=INFO
SEMENTE_ALEATORIA=42

# --- Coleta automatica (opcional) ----------------------------
# Desligada por padrao: a atualizacao normal e manual, pelo botao do dashboard.
# Ligue so se quiser que o SERVIDOR atualize sozinho (maquina sempre ligada):
# COLETA_AUTOMATICA=true
# COLETA_INTERVALO_HORAS=24

# --- Modelo do agente do Loop -------------------------------
# O modelo e a temperatura ficam em `meu-loop-agente/config_loop.json` -> `agente`.
# O VALOR da chave NAO vai aqui nem em nenhum arquivo versionado: ele vive na
# variavel de ambiente do usuario do Windows. Para definir:
#   [Environment]::SetEnvironmentVariable('DEEPSEEK_API_KEY', '<valor>', 'User')
#   (reinicie o terminal/VS Code: processo ja aberto nao enxerga a variavel nova)
DEEPSEEK_API_KEY=
