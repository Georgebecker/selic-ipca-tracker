# ---- Ambiente e segredos ----
# .env NUNCA pode ir para o git (regra de ouro): guarda chaves, senhas e caminhos.
.env
.env.*
!.env.example
.venv/
venv/

# ---- Dados (nunca versionar dados) ----
data/raw/*
data/processed/*
data/descartados/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/descartados/.gitkeep
data/backups/
*.parquet
*.jsonl
*.sqlite
*.db

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- Saídas e logs ----
saidas/
logs/
*.log

# ---- IDE / SO ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Documentos pessoais de metodo (ficam so na minha maquina) ----
# Nao vao para o repositorio: sao o "como eu trabalho", nao o projeto. Se um dia
# precisarem voltar, basta remover a linha e commitar de novo.
REGRAS_DE_OURO.md
modelo.md
NOTES.md
log_loop.md
meu-loop-agente/program.md
meu-loop-agente/system_prompt.md
meu-loop-agente/README.md
